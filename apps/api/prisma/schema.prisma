generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum EventStatus {
  DRAFT
  ACTIVE
  LAST_ARCHIVED
  HIDDEN
}

enum PricingStatus {
  ACTIVE
  UPCOMING
  SOLD_OUT
}

enum MediaType {
  IMAGE
  VIDEO
}

enum RegistrationStatus {
  PENDING
  PAID
  CANCELLED
}

enum SponsorTier {
  MAIN
  GOLD
  SILVER
  PARTNER
}

model Event {
  id             String      @id @default(cuid())
  edition        String      @unique // ej: "2027", "2026"
  status         EventStatus @default(DRAFT)
  tagline        String
  slogan         String
  dateText       String
  startTime      String
  location       String
  distanceLabel  String
  realDistance   String
  whatsappNumber String
  socialHandle   String
  desktopCoverId String?
  mobileCoverId  String?
  routeDriveId   String?
  routeImageUrl  String?
  stats          Json?
  description    String?     @db.Text

  pricingTiers  PricingTier[]
  mediaItems    MediaItem[]
  registrations Registration[]
  sponsors      Sponsor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model PricingTier {
  id             String        @id @default(cuid())
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  subtitle       String
  priceSoles     Int
  status         PricingStatus @default(UPCOMING)
  totalSlots     Int           @default(100)
  availableSlots Int           @default(100)
  benefits       Json
  sortOrder      Int           @default(0)

  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, status])
}

model MediaItem {
  id               String    @id @default(cuid())
  eventId          String
  event            Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type             MediaType
  title            String
  driveFileId      String?
  youtubeId        String?
  thumbnailDriveId String?
  sortOrder        Int       @default(0)

  createdAt DateTime @default(now())

  @@index([eventId, type])
}

model Registration {
  id               String             @id @default(cuid())
  eventId          String
  event            Event              @relation(fields: [eventId], references: [id])
  pricingTierId    String
  pricingTier      PricingTier        @relation(fields: [pricingTierId], references: [id])
  dni              String
  firstName        String
  lastName         String
  email            String
  phone            String
  shirtSize        String
  emergencyContact String
  emergencyPhone   String
  amountPaid       Int
  status           RegistrationStatus @default(PENDING)
  paymentRef       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, dni])
  @@index([eventId, status])
}

model Sponsor {
  id          String      @id @default(cuid())
  eventId     String?
  event       Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  name        String
  tier        SponsorTier @default(PARTNER)
  driveFileId String?
  logoUrl     String?
  websiteUrl  String?
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}